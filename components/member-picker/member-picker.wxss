/**
 * 成员选择器组件样式
 */

.member-picker {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 搜索栏 */
.member-picker__search {
  padding: 16rpx 0;
}

/* 工具栏 */
.member-picker__toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}

.member-picker__count {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.member-picker__toolbar-actions {
  display: flex;
  gap: 12rpx;
}

/* 成员列表 */
.member-picker__list {
  flex: 1;
  max-height: 500rpx;
}

.member-picker__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: var(--bg-color);
  transition: all 0.2s;
}

.member-picker__item--selected {
  background: rgba(25, 118, 210, 0.08);
  border: 2rpx solid var(--primary);
}

.member-picker__item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-picker__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--border-color);
}

.member-picker__name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.member-picker__dept {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.member-picker__item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-picker__check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 已选预览 */
.member-picker__selected {
  padding: 16rpx 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.member-picker__selected-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 随机选择弹窗 */
.member-picker__modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.member-picker__modal-content {
  width: 85%;
  background: #FFF;
  border-radius: 20rpx;
  padding: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.member-picker__modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--text-primary);
}

.member-picker__modal-body {
  margin-bottom: 32rpx;
}

.member-picker__random-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.member-picker__random-unit {
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.member-picker__modal-footer {
  display: flex;
  gap: 16rpx;
}
