/**
 * 状态标签组件样式
 */

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
  transition: all 0.3s;
}

.status-badge--sm {
  padding: 4rpx 12rpx;
}

.status-badge--md {
  padding: 8rpx 18rpx;
}

.status-badge--lg {
  padding: 12rpx 24rpx;
}

.status-badge__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-badge--sm .status-badge__dot {
  width: 8rpx;
  height: 8rpx;
}

.status-badge--lg .status-badge__dot {
  width: 16rpx;
  height: 16rpx;
}

.status-badge__text {
  font-size: 22rpx;
  line-height: 1;
}

.status-badge--sm .status-badge__text {
  font-size: 20rpx;
}

.status-badge--lg .status-badge__text {
  font-size: 26rpx;
}
