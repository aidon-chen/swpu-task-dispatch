/**
 * 任务详情页面样式
 */

/* 头部 */
.detail-header {
  background: linear-gradient(135deg, #1976D2, #0D47A1);
  padding: 32rpx 24rpx;
  color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.detail-header-top {
  margin-bottom: 16rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-type {
  font-size: 24rpx;
  opacity: 0.85;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 4rpx;
}

/* 信息行 */
.detail-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-color);
}

.detail-info-row:last-child {
  border-bottom: none;
}

.detail-info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.detail-info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.detail-link {
  color: var(--primary);
}

/* 成员列表 */
.detail-members {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-member-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-color);
  flex-shrink: 0;
}

.detail-member-name {
  font-size: 26rpx;
  font-weight: 500;
}

.detail-member-dept {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
}

/* 描述 */
.detail-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 操作栏 */
.detail-actions {
  padding: 32rpx 0;
}

/* 弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.detail-modal-content {
  width: 85%;
  background: #FFF;
  border-radius: 20rpx;
  padding: 40rpx;
}

.detail-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.detail-modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
