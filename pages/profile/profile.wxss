/**
 * 个人中心页面样式
 */

/* 用户信息头部 */
.profile-header {
  background: linear-gradient(135deg, #1976D2, #0D47A1);
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #FFFFFF;
  margin-bottom: 32rpx;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  margin-bottom: 16rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.profile-info {
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.profile-info .tag {
  background: rgba(255, 255, 255, 0.2);
  color: #FFF;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.profile-semester {
  font-size: 24rpx;
  opacity: 0.7;
}

/* 菜单列表 */
.profile-menus {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.profile-menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: #FFF;
  border-radius: 12rpx;
  box-shadow: var(--shadow);
  transition: all 0.2s;
}

.profile-menu-item:active {
  background: #FAFAFA;
  transform: scale(0.99);
}

.profile-menu-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.profile-menu-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.profile-menu-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.profile-menu-arrow {
  font-size: 40rpx;
  color: var(--text-hint);
  flex-shrink: 0;
}

/* 底部 */
.profile-footer {
  padding: 16rpx 0;
}
