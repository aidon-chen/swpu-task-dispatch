/**
 * 创建/编辑任务页面样式
 */

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 16rpx 0;
}

.form-item-gap {
  gap: 0;
}

.form-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.4;
}

/* 机位选择 */
.location-picker {
  white-space: nowrap;
  padding: 8rpx 0;
}

.location-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.location-chip--active {
  background: var(--primary);
  color: #FFFFFF;
}

/* 提交按钮 */
.form-actions {
  display: flex;
  padding: 32rpx 0;
}

.form-actions button {
  margin: 0;
}

/* 日期选择器 */
.picker-datetime {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFF;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx;
  z-index: 1000;
}

/* 小号按钮 */
.btn-sm {
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  line-height: 1.6;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border-color, #ebedf0);
  margin: 20rpx 0;
}

/* 模板选择弹层 */
.modal-mask {
  position: fixed;
  inset: 0;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-sheet {
  width: 100%;
  max-height: 70vh;
  background: #FFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  font-size: 32rpx;
  color: var(--text-hint);
  padding: 0 12rpx;
}

.modal-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-hint);
}

.modal-list {
  flex: 1;
  max-height: 52vh;
}

.template-item {
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--bg-color);
  margin-bottom: 16rpx;
}

.template-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.template-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.template-desc {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 6rpx;
  line-height: 1.4;
}
