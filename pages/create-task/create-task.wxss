/**
 * 创建/编辑任务页面样式
 */

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 16rpx 0;
}

.form-item-gap {
  gap: 0;
}

.form-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.4;
}

/* 机位选择 */
.location-picker {
  white-space: nowrap;
  padding: 8rpx 0;
}

.location-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: var(--bg-color);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.location-chip--active {
  background: var(--primary);
  color: #FFFFFF;
}

/* 提交按钮 */
.form-actions {
  display: flex;
  padding: 32rpx 0;
}

.form-actions button {
  margin: 0;
}

/* 日期选择器 */
.picker-datetime {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFF;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx;
  z-index: 1000;
}
