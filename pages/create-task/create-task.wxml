<!-- 创建/编辑任务页面 -->
<view class="container" wx:if="{{ready}}">
  <view class="page-title">{{isEdit ? '编辑任务' : '创建新任务'}}</view>

  <!-- 模板操作 -->
  <view class="card">
    <view class="flex-between">
      <view class="form-label">从模板创建</view>
      <button class="btn btn-outline btn-sm" bindtap="onOpenTemplatePicker">选择模板</button>
    </view>
    <view wx:if="{{appliedTemplateName}}" class="form-hint mt-8">已套用模板：{{appliedTemplateName}}</view>

    <view class="divider"></view>

    <view class="flex-between">
      <view class="form-label">存为模板</view>
      <switch checked="{{form.isTemplate}}" bindchange="onToggleSaveTemplate" color="#1976D2"/>
    </view>
    <view wx:if="{{form.isTemplate}}" class="form-item mt-8">
      <view class="form-label">模板名称</view>
      <input class="form-input" placeholder="留空则使用任务标题" value="{{form.templateName}}" bindinput="onTemplateNameInput" maxlength="30"/>
      <view class="form-hint mt-8">保存为模板后，可在创建同类任务时一键套用（无需填写时间与人员）</view>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="card-title">基本信息</view>

    <view class="form-item">
      <view class="form-label">任务标题 <text class="required">*</text></view>
      <input class="form-input" placeholder="请输入任务标题" value="{{form.title}}" bindinput="onTitleInput" maxlength="50"/>
    </view>

    <view class="form-item">
      <view class="form-label">任务类型 <text class="required">*</text></view>
      <picker mode="selector" range="{{taskTypes}}" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="form-picker">
          <text class="{{form.type ? '' : 'placeholder'}}">{{form.type || '请选择任务类型'}}</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">优先级</view>
      <picker mode="selector" range="{{priorities}}" range-key="label" value="{{priorityIndex}}" bindchange="onPriorityChange">
        <view class="form-picker">
          <text>{{priorities[priorityIndex].label}}</text>
        </view>
      </picker>
    </view>

    <view class="flex-row form-item-gap">
      <view class="form-item flex-1">
        <view class="form-label">开始时间 <text class="required">*</text></view>
        <picker mode="multiSelector" range="{{startRange}}" value="{{startValue}}" bindchange="onStartTimeChange" bindcolumnchange="onStartTimeColumnChange">
          <view class="form-picker">
            <text class="{{form.startTime ? '' : 'placeholder'}}">{{form.startTime || '选择开始时间'}}</text>
          </view>
        </picker>
      </view>
      <view class="form-item flex-1 ml-16">
        <view class="form-label">结束时间</view>
        <picker mode="multiSelector" range="{{endRange}}" value="{{endValue}}" bindchange="onEndTimeChange" bindcolumnchange="onEndTimeColumnChange">
          <view class="form-picker">
            <text class="{{form.endTime ? '' : 'placeholder'}}">{{form.endTime || '选择结束时间'}}</text>
          </view>
        </picker>
      </view>
    </view>
  </view>

  <!-- 地点与联络 -->
  <view class="card">
    <view class="card-title">地点与联络</view>

    <view class="form-item">
      <view class="form-label">任务地点</view>
      <input class="form-input" placeholder="请输入任务地点" value="{{form.location}}" bindinput="onLocationInput"/>
    </view>

    <!-- 关联机位 -->
    <view class="form-item" wx:if="{{locations.length > 0}}">
      <view class="form-label">关联机位</view>
      <scroll-view class="location-picker" scroll-x>
        <block wx:for="{{locations}}" wx:key="_id">
          <view
            class="location-chip {{form.locationId === item._id ? 'location-chip--active' : ''}}"
            data-id="{{item._id}}"
            bindtap="onLocationSelect"
          >{{item.name}}</view>
        </block>
      </scroll-view>
    </view>

    <view class="form-item">
      <view class="form-label">联络人</view>
      <input class="form-input" placeholder="请输入联络人（如被拍摄方联系人）" value="{{form.contact}}" bindinput="onContactInput"/>
    </view>
  </view>

  <!-- 人员指派 -->
  <view class="card">
    <view class="card-title">指派人员 <text class="required">*</text></view>
    <member-picker
      selectedIds="{{form.assignedTo}}"
      department="{{department}}"
      showRandom="{{true}}"
      bind:change="onMemberChange"
    />
  </view>

  <!-- 更多设置 -->
  <view class="card">
    <view class="card-title">更多设置</view>

    <!-- 跨部门 -->
    <view class="form-item">
      <view class="flex-between">
        <view class="form-label">跨部门任务</view>
        <switch checked="{{form.isCrossDepartment}}" bindchange="onToggleCrossDept" color="#1976D2"/>
      </view>
      <view wx:if="{{form.isCrossDepartment}}" class="form-hint mt-8">
        开启后，该任务将同时推送给摄影部和视频部
      </view>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <view class="form-label">任务描述</view>
      <textarea class="form-textarea" placeholder="详细描述任务内容、注意事项等" value="{{form.description}}" bindinput="onDescInput" maxlength="500"/>
    </view>

    <!-- 成果交付 -->
    <view class="form-item">
      <view class="form-label">成果要求</view>
      <textarea class="form-textarea" placeholder="描述需要交付的成果（如照片数量、视频时长等）" value="{{form.deliverables}}" bindinput="onDeliverablesInput" maxlength="300"/>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="form-actions">
    <button class="btn btn-outline" bindtap="onSaveDraft">保存草稿</button>
    <button
      class="btn btn-primary flex-1 ml-16"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >{{isEdit ? '更新任务' : (form.isTemplate ? '保存模板' : '创建任务')}}</button>
  </view>

  <!-- 底部安全距离 -->
  <view class="safe-bottom" style="height: 60rpx;"></view>

  <!-- 模板选择弹层 -->
  <view wx:if="{{showTemplatePicker}}" class="modal-mask" bindtap="onCloseTemplatePicker">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">选择任务模板</text>
        <text class="modal-close" bindtap="onCloseTemplatePicker">✕</text>
      </view>
      <view wx:if="{{templateLoading}}" class="modal-empty">加载中...</view>
      <view wx:elif="{{templates.length === 0}}" class="modal-empty">暂无模板，可先在“存为模板”中保存常用任务</view>
      <scroll-view wx:else class="modal-list" scroll-y>
        <view
          wx:for="{{templates}}"
          wx:key="_id"
          class="template-item"
          data-id="{{item._id}}"
          bindtap="onSelectTemplate"
        >
          <view class="template-name">{{item.templateName}}</view>
          <view class="template-meta">{{item.type}}{{item.isCrossDepartment ? ' · 跨部门' : ''}}{{item.location ? ' · ' + item.location : ''}}</view>
          <view wx:if="{{item.description}}" class="template-desc">{{item.description}}</view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
