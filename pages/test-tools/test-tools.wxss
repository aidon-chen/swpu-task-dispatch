/* 测试工具中心样式 */

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.status-label {
  color: #999;
}

.status-value {
  font-weight: 500;
}

.status-on {
  color: #4CAF50;
}

.status-off {
  color: #F44336;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.count-chips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.count-chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  background: #F5F5F5;
  border: 2rpx solid transparent;
}

.count-chip--active {
  color: #1976D2;
  background: #E6F1FB;
  border-color: #1976D2;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
