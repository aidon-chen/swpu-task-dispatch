.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  padding: 40rpx;
}

.card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}

.icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.status-box {
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.status-ready {
  background: #f0f7ff;
  color: #666;
}

.status-loading {
  background: #fff7e6;
  color: #e6a23c;
}

.status-success {
  background: #f0f9eb;
  color: #67c23a;
}

.status-error {
  background: #fef0f0;
  color: #f56c6c;
}

.results {
  text-align: left;
  font-size: 26rpx;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.result-item {
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.result-item .label {
  font-weight: 600;
  margin-right: 8rpx;
}

.result-item.error {
  color: #f56c6c;
}

.init-btn {
  width: 100%;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.init-btn.disabled {
  background: #a0d9b8;
}

.back-btn {
  width: 100%;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 20rpx;
}
