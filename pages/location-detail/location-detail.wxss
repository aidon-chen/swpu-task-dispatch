/**
 * 机位详情页面样式
 */

.loc-detail-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.loc-detail-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.loc-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.loc-detail-notes {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: 8rpx;
  display: block;
}

.loc-detail-images {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.loc-detail-image {
  width: 100%;
  border-radius: 8rpx;
}

/* 标签编辑 */
.loc-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.loc-tag-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: rgba(25, 118, 210, 0.1);
  color: var(--primary);
  border-radius: 20rpx;
  font-size: 24rpx;
}

.loc-tag-remove {
  font-size: 20rpx;
  padding: 2rpx 6rpx;
  color: var(--danger);
}

/* 图片编辑 */
.loc-image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.loc-image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.loc-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.loc-image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--danger);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.loc-image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loc-image-add-icon {
  font-size: 60rpx;
  color: var(--text-hint);
}
