/**
 * 统计报表页面样式
 */

.stats-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  padding-top: 16rpx;
}

.stats-filters {
  margin-bottom: 24rpx;
}

.stats-filters-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap; /* 极端窄屏/大字体下允许换行兜底，避免溢出容器 */
}

.stats-filter-btn {
  flex: 1;
  min-width: 0; /* 允许 flex 子项收缩到小于内容宽度（华为大字体下文字不被撑出） */
  overflow: hidden;
  text-overflow: ellipsis; /* 超宽文字省略号 */
  white-space: nowrap; /* 文字不换行 */
  text-align: center;
  padding: 14rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #FFF;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.stats-filter-btn--active {
  background: var(--primary);
  color: #FFF;
}

.stats-date-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mx-8 { margin: 0 8rpx; }

/* 汇总 */
.stats-summary {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stats-summary-item {
  flex: 1;
  background: #FFF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow);
}

.stats-summary-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.stats-summary-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.stats-view-toggle {
  font-size: 24rpx;
  color: var(--primary);
  padding: 8rpx 16rpx;
}

/* 列表 */
.stats-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stats-list-item {
  display: block;
}

.stats-list-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.stats-list-count {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
}

.stats-list-tasks {
  margin-top: 8rpx;
}

.stats-task-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  border-top: 1rpx solid var(--bg-color);
}

.stats-task-date {
  font-size: 22rpx;
  color: var(--text-hint);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 条形视图 */
.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.bar-name {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-primary);
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: var(--bg-color);
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-light), var(--primary));
  border-radius: 999rpx;
  transition: width 0.3s;
}

.bar-value {
  width: 60rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
}

/* 自定义日期选择器：明确可点击视觉反馈 */
.stats-date-picker {
  background: var(--bg-color, #fff);
  border: 2rpx solid var(--border-color, #e0e0e0);
  border-radius: 12rpx;
  cursor: pointer;
}
.stats-date-picker:active {
  background: #e6f4ff;
  border-color: #1976D2;
}
