<!-- 统计报表页面 -->
<view class="stats-page">
  <!-- 自定义导航栏 -->
  <custom-nav-bar title="统计报表" backgroundColor="#1976D2" noPlaceholder />
  
  <view class="container">
  <!-- 筛选栏 -->
  <view class="stats-filters">
    <view class="stats-filters-row">
      <block wx:for="{{periodOptions}}" wx:key="value">
        <view
          class="stats-filter-btn {{filter.period === item.value ? 'stats-filter-btn--active' : ''}}"
          data-period="{{item.value}}"
          bindtap="onPeriodChange"
        >{{item.label}}</view>
      </block>
    </view>

    <!-- 自定义日期 -->
    <view wx:if="{{filter.period === 'custom'}}" class="stats-date-range mt-16">
      <picker mode="date" value="{{filter.startDate}}" start="1970-01-01" end="2099-12-31" fields="day" bindchange="onStartDateChange">
        <view class="form-picker stats-date-picker">{{filter.startDate || '开始日期'}}</view>
      </picker>
      <text class="mx-8">~</text>
      <picker mode="date" value="{{filter.endDate}}" start="1970-01-01" end="2099-12-31" fields="day" bindchange="onEndDateChange">
        <view class="form-picker stats-date-picker">{{filter.endDate || '结束日期'}}</view>
      </picker>
    </view>

    <!-- 学期选择 -->
    <view wx:if="{{filter.period === 'semester'}}" class="mt-16">
      <picker mode="selector" range="{{semesters}}" bindchange="onSemesterChange">
        <view class="form-picker">{{filter.semester || '选择学期'}}</view>
      </picker>
    </view>
  </view>

  <!-- 汇总数字 -->
  <view class="stats-summary">
    <view class="stats-summary-item">
      <text class="stats-summary-num">{{summary.totalTasks}}</text>
      <text class="stats-summary-label">总任务数</text>
    </view>
    <view class="stats-summary-item">
      <text class="stats-summary-num" style="color: #4CAF50">{{summary.completedTasks}}</text>
      <text class="stats-summary-label">已完成</text>
    </view>
    <view class="stats-summary-item">
      <text class="stats-summary-num" style="color: #FF9800">{{summary.totalHours}}</text>
      <text class="stats-summary-label">总工时(h)</text>
    </view>
    <view class="stats-summary-item">
      <text class="stats-summary-num" style="color: #2196F3">{{summary.avgPerPerson}}</text>
      <text class="stats-summary-label">人均任务</text>
    </view>
    <view class="stats-summary-item">
      <text class="stats-summary-num" style="color: #FA8C16">{{summary.avgScore || '-'}}</text>
      <text class="stats-summary-label">平均评分</text>
    </view>
  </view>

  <!-- 视图切换 -->
  <view class="flex-between mb-16">
    <view class="card-title" style="margin-bottom: 0;">成员明细</view>
    <view class="stats-view-toggle" bindtap="onToggleView">
      <t-icon class="icon-inline" name="{{showChart ? 'view-list' : 'chart-bar'}}" size="30rpx"/>{{showChart ? '列表' : '条形'}}
    </view>
  </view>

  <!-- 条形视图（按任务量占比） -->
  <view wx:if="{{showChart}}" class="card">
    <block wx:for="{{detailList}}" wx:key="_id">
      <view class="bar-row">
        <text class="bar-name text-ellipsis">{{item.name}}</text>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.barPercent}}%;"></view>
        </view>
        <text class="bar-value">{{item.total}}</text>
      </view>
    </block>
    <view wx:if="{{detailList.length === 0}}" class="empty-state" style="padding: 60rpx 0;">
      <text class="text">该周期暂无任务数据</text>
    </view>
  </view>

  <!-- 列表视图 -->
  <block wx:if="{{!showChart}}">
    <view class="stats-list">
      <block wx:for="{{detailList}}" wx:key="_id">
        <view class="stats-list-item card">
          <view class="flex-between mb-8">
            <text class="stats-list-name">{{item.name}}</text>
            <text class="stats-list-count">{{item.total}} 次 · 完成 {{item.completed}}（{{item.rate}}%）· 评分 {{item.avgScore || '-'}}</text>
          </view>
          <view wx:if="{{item.tasks.length > 0}}" class="stats-list-tasks">
            <block wx:for="{{item.tasks}}" wx:key="_id" wx:for-item="t">
              <view class="stats-task-row">
                <text class="text-ellipsis flex-1">{{t.title}}</text>
                <text class="stats-task-date">{{t.date}}</text>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{detailList.length === 0}}" class="empty-state" style="padding: 60rpx 0;">
      <text class="text">该周期暂无任务数据</text>
    </view>
  </block>

  <!-- 导出按钮 -->
  <button class="btn btn-primary btn-block mt-24" loading="{{loading}}" bindtap="onExport"><t-icon class="icon-inline" name="export" size="32rpx"/>导出报表（复制到剪贴板）</button>

  <view style="height: 60rpx;"></view>
</view>
</view>
