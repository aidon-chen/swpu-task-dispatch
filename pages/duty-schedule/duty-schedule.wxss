/**
 * 值班表页面样式
 */

/* 统计摘要 */
.schedule-summary {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.schedule-summary-item {
  flex: 1;
  background: #FFF;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: var(--shadow);
}

.schedule-summary-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.schedule-summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 月份导航 */
.schedule-month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.schedule-month-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.schedule-month-arrow {
  font-size: 28rpx;
  padding: 8rpx 16rpx;
  color: var(--primary);
}

.schedule-view-toggle {
  font-size: 24rpx;
  color: var(--primary);
  margin-left: auto;
}

/* 日历 */
.schedule-calendar {
  background: #FFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.schedule-weekdays {
  display: flex;
  background: var(--primary);
  color: #FFF;
}

.schedule-weekday {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
}

.schedule-days {
  display: flex;
  flex-wrap: wrap;
}

/* 点选版月历（日程并入）：today/selected 高亮挂固定尺寸 num，防 border 撑宽错位 */
.schedule-day {
  width: 14.28%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
  font-size: 26rpx;
  color: #444;
}

.schedule-day--empty {
  visibility: hidden;
}

.schedule-day--weekend {
  color: #B0B0B0;
}

.schedule-day--today .schedule-day-num {
  border: 2rpx solid #1976D2;
}

.schedule-day--selected .schedule-day-num {
  background: #1976D2;
  color: #FFF;
}

.schedule-day-num {
  box-sizing: border-box;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
}

.schedule-today-btn {
  font-size: 24rpx;
  color: #1976D2;
  border: 1rpx solid #B5D4F4;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
}

/* 当天三区（任务/值班/成员空余五态） */
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.schedule-summary {
  font-size: 24rpx;
  color: #1976D2;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.task-row:last-child {
  border-bottom: none;
}

.task-time {
  font-size: 24rpx;
  color: #1976D2;
  background: #E6F1FB;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.task-title {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.status-pending { color: #854F0B; background: #FAEEDA; }
.status-confirmed { color: #3B6D11; background: #EAF3DE; }
.status-in_progress { color: #BA7517; background: #FAEEDA; }
.status-completed { color: #888; background: #F1EFE8; }

.member-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.member-cell {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 12rpx;
  background: #F7F8F9;
  border-radius: 12rpx;
}

.member-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.member-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-state {
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.state-available { color: #3B6D11; background: #EAF3DE; }
.state-busy { color: #BA7517; background: #FAEEDA; }
.state-unavailable { color: #A32D2D; background: #FCEBEB; }
.state-duty { color: #0C447C; background: #E6F1FB; }
.state-task { color: #534AB7; background: #EEEDFE; }

.empty-hint {
  font-size: 26rpx;
  color: #999;
  padding: 12rpx 0;
}

/* 可用性矩阵 */
.schedule-matrix {
  white-space: nowrap;
}

.schedule-matrix-header {
  display: flex;
  border-bottom: 1rpx solid var(--border-color);
}

.schedule-matrix-name-col {
  width: 120rpx;
  flex-shrink: 0;
  padding: 12rpx 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.schedule-matrix-date-col {
  width: 56rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.schedule-matrix-row {
  display: flex;
  border-bottom: 1rpx solid var(--bg-color);
}

.schedule-matrix-cell {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
}

.schedule-cell-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.schedule-cell-dot--available { background: #4CAF50; }
.schedule-cell-dot--busy { background: #FF9800; }
.schedule-cell-dot--unavailable { background: #F44336; }

/* 可编辑单元格（主任） */
.schedule-matrix-cell--editable {
  cursor: pointer;
}

.schedule-matrix-cell--editable:active {
  background: var(--bg-color);
}

/* 矩阵编辑提示 */
.schedule-matrix-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 列表视图 */
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.schedule-member-card {
  transition: all 0.2s;
}

.schedule-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.schedule-member-name {
  font-size: 28rpx;
  font-weight: 500;
}

.schedule-member-dept {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 2rpx;
}

.schedule-detail {
  padding: 16rpx;
  background: var(--bg-color);
  border-radius: 8rpx;
}

.schedule-detail-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

/* 操作按钮 */
.schedule-actions {
  display: flex;
  gap: 16rpx;
}

/* 周固定时间 */
.schedule-week-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-color);
}

.schedule-week-item:last-child {
  border-bottom: none;
}

.schedule-timepicker {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 16rpx;
  background: var(--bg-color);
  border-radius: 8rpx;
}

.mx-8 {
  margin: 0 8rpx;
}

/* ===== 本周值班安排（PRD 值班表导入） ===== */
.duty-day {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.duty-day:last-child {
  border-bottom: none;
}

.duty-day-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.duty-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.duty-slot {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 24rpx;
  color: #1976D2;
  padding-top: 4rpx;
}

.duty-cells {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
}

.duty-team {
  color: #999;
}

.duty-names {
  color: #333;
}

.duty-actions {
  margin-top: 20rpx;
}

/* 本周值班折叠头部 */
.duty-collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0;
}

.duty-collapse-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.duty-collapse-summary {
  font-size: 26rpx;
  color: #999;
}

.duty-collapse-arrow {
  font-size: 28rpx;
  color: #1976D2;
  padding: 8rpx 0 8rpx 16rpx;
}

.duty-link {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #1976D2;
}
