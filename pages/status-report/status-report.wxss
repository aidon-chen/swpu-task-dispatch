/**
 * 状态上报页面样式
 */

/* 状态选择 */
.status-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.status-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: var(--bg-color);
  border: 2rpx solid transparent;
  position: relative;
  transition: all 0.2s;
}

.status-option--active {
  border-color: var(--primary);
  background: rgba(25, 118, 210, 0.04);
}

.status-option-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.status-option-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
  width: 120rpx;
}

.status-option-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex: 1;
}

.status-option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 图片 */
.status-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.status-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.status-image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--danger);
  color: #FFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.status-image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.status-image-add-icon {
  font-size: 40rpx;
  color: var(--text-hint);
}

.status-image-add-text {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 历史记录 */
.status-history {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.status-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.status-history-date {
  font-size: 24rpx;
  color: var(--text-hint);
}
