/**
 * 首页样式
 */

.index-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 头部 - 与导航栏无缝衔接 */
.index-header {
  background: linear-gradient(135deg, #1976D2, #0D47A1);
  padding: 16rpx 24rpx 32rpx;
  color: #FFFFFF;
}

.index-greeting {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.index-stats {
  display: flex;
  gap: 16rpx;
}

.index-stat-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
}

.index-stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.index-stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* 搜索栏 */
.index-search {
  padding: 20rpx 24rpx;
}

/* 标签切换 */
.index-tabs {
  display: flex;
  padding: 0 24rpx;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.index-tab {
  flex: 1;
  min-width: 0; /* 允许收缩，华为大字体下文字不被撑出 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  padding: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-bottom: 3rpx solid transparent;
  transition: all 0.2s;
}

.index-tab--active {
  color: var(--primary);
  border-bottom-color: var(--primary);
  font-weight: 600;
}

/* 状态筛选 */
.index-filters {
  white-space: nowrap;
  padding: 12rpx 24rpx;
}

.index-filter-item {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: var(--bg-white);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.index-filter-item--active {
  background: var(--primary);
  color: #FFFFFF;
}

/* 任务列表 */
.index-task-list {
  padding: 16rpx 24rpx;
}

/* 浮动创建按钮 */
.index-fab {
  position: fixed;
  bottom: 160rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 8rpx 24rpx rgba(25, 118, 210, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.index-fab:active {
  transform: scale(0.95);
}

.index-fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* ===== M9 高级筛选 ===== */
.index-filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 4rpx;
  font-size: 26rpx;
  color: #1976D2;
}

.index-filter-toggle-text {
  margin-right: 8rpx;
}

.index-filter-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FA8C16;
}

.index-filter-panel {
  background: #FFF;
  border-radius: 16rpx;
  margin: 12rpx 24rpx;
  padding: 24rpx;
}

.index-filter-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.index-filter-grid .form-input {
  height: 72rpx;
  box-sizing: border-box;
}

.index-cross-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 8rpx 4rpx;
}

.index-filter-actions {
  display: flex;
  margin-top: 24rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
