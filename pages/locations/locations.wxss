/**
 * 机位管理列表样式
 */

.location-tags {
  margin-bottom: 16rpx;
}

.location-tags-scroll {
  white-space: nowrap;
}

.location-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: #FFF;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.location-tag--active {
  background: var(--primary);
  color: #FFF;
}

.location-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.location-card {
  padding: 0;
  overflow: hidden;
}

.location-card-image {
  width: 100%;
  height: 200rpx;
  background: var(--bg-color);
}

.location-card-placeholder {
  width: 100%;
  height: 200rpx;
  background: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.location-card-body {
  padding: 20rpx;
}

.location-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.location-card-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.location-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
}

.location-card-actions {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 20rpx;
  border-top: 1rpx solid var(--bg-color);
}

.location-card-action {
  font-size: 22rpx;
  color: var(--danger);
  padding: 4rpx 8rpx;
}
