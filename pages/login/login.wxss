/**
 * 登录页面样式
 */

.login-container {
  min-height: 100vh;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #1976D2 0%, #0D47A1 40%, #F5F5F5 40%);
}

/* 头部 */
.login-header {
  text-align: center;
  padding: 60rpx 0 80rpx;
  color: #FFFFFF;
}

.login-logo {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.login-subtitle {
  font-size: 26rpx;
  opacity: 0.8;
}

/* 主体 */
.login-body {
  position: relative;
  z-index: 1;
}

/* 头像 */
.login-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.login-avatar-btn {
  background: none;
  border: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.login-avatar-btn::after {
  border: none;
}

.login-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--bg-color);
  border: 4rpx solid var(--primary-light);
}

.login-avatar-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 部门选择 */
.login-section-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.login-dept-list {
  display: flex;
  gap: 24rpx;
}

.login-dept-item {
  flex: 1;
  padding: 40rpx 20rpx;
  border-radius: 16rpx;
  border: 3rpx solid var(--border-color);
  text-align: center;
  position: relative;
  transition: all 0.2s;
  background: var(--bg-color);
}

.login-dept-item--selected {
  border-color: var(--primary);
  background: rgba(25, 118, 210, 0.05);
}

.login-dept-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.login-dept-label {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.login-dept-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.login-dept-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 密钥 */
.login-key-section {
  margin-top: 40rpx;
}

.login-key-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--primary);
}

.login-key-arrow {
  font-size: 22rpx;
  color: var(--text-hint);
}

.login-key-input {
  animation: slideDown 0.3s ease;
}

.login-key-hint {
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.4;
}

/* 底部 */
.login-footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 调试登录 */
.debug-section {
  border-radius: 12rpx;
  border: 2rpx dashed #FF9800;
  background: rgba(255, 152, 0, 0.05);
  overflow: hidden;
}

.debug-toggle {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #E65100;
}

.debug-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.debug-text {
  flex: 1;
  font-weight: 500;
}

.debug-arrow {
  font-size: 24rpx;
  color: #E65100;
}

.debug-panel {
  padding: 0 32rpx 32rpx;
}

.debug-hint {
  font-size: 22rpx;
  color: #F57C00;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.debug-picker {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 2rpx solid #FFE0B2;
}

.debug-picker-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.debug-picker-value {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.debug-picker-arrow {
  font-size: 32rpx;
  color: var(--text-hint);
}

.btn-debug {
  background: #FF9800;
  color: #FFFFFF;
}

.btn-debug:active {
  background: #F57C00;
}

.btn-debug::after {
  border: none;
}

/* 返回修改 */
.login-switch {
  color: var(--primary);
  font-size: 26rpx;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
