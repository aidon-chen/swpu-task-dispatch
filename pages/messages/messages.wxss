.container {
  min-height: 100vh;
  background: #F5F5F5;
  padding: 16rpx;
  box-sizing: border-box;
}

/* 顶部操作栏 */
.msg-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.msg-toolbar-tip {
  font-size: 26rpx;
  color: #757575;
}
.msg-readall-btn {
  margin: 0;
  font-size: 26rpx;
  color: #1976D2;
  background: #E3F2FD;
  border-radius: 32rpx;
}

/* 列表 */
.msg-list {
  display: flex;
  flex-direction: column;
}
.msg-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}
.msg-item.is-read {
  opacity: 0.62;
}
.msg-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  background: #E3F2FD;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.msg-body {
  flex: 1;
  min-width: 0;
}
.msg-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.msg-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1976D2;
}
.msg-time {
  font-size: 22rpx;
  color: #9e9e9e;
}
.msg-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  word-break: break-all;
}
.msg-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #F44336;
}

.msg-foot {
  text-align: center;
  font-size: 24rpx;
  color: #9e9e9e;
  padding: 24rpx 0;
}

/* 空态 */
.msg-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 40rpx;
}
.msg-empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.msg-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #424242;
  margin-bottom: 12rpx;
}
.msg-empty-desc {
  font-size: 26rpx;
  color: #9e9e9e;
  text-align: center;
  margin-bottom: 40rpx;
}
.msg-empty-btn {
  background: #1976D2;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 56rpx;
}
