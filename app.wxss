/**
 * 全局样式 - 任务派发系统
 * 西南石油大学视觉中心
 */

/* ========== CSS变量定义 ========== */
page {
  --primary: #1976D2;
  --primary-light: #42A5F5;
  --primary-dark: #0D47A1;
  --success: #4CAF50;
  --warning: #FF9800;
  --danger: #F44336;
  --info: #2196F3;
  --text-primary: #212121;
  --text-secondary: #757575;
  --text-hint: #BDBDBD;
  --bg-color: #F5F5F5;
  --bg-white: #FFFFFF;
  --border-color: #E0E0E0;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-color);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ========== 通用布局类 ========== */
.container {
  padding: 24rpx;
  min-height: 100vh;
}

.card {
  background: var(--bg-white);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 按钮样式 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0 40rpx;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active {
  background: var(--primary-dark);
}

.btn-success {
  background: var(--success);
  color: #FFFFFF;
}

.btn-warning {
  background: var(--warning);
  color: #FFFFFF;
}

.btn-danger {
  background: var(--danger);
  color: #FFFFFF;
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-sm {
  height: 60rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
}

.btn-block {
  width: 100%;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ========== 表单样式 ========== */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label .required {
  color: var(--danger);
  margin-left: 6rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 88rpx;
  background: var(--bg-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker .placeholder {
  color: var(--text-hint);
}

/* ========== 标签/徽章 ========== */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-primary {
  background: rgba(25, 118, 210, 0.1);
  color: var(--primary);
}

.tag-success {
  background: rgba(76, 175, 80, 0.1);
  color: var(--success);
}

.tag-warning {
  background: rgba(255, 152, 0, 0.1);
  color: var(--warning);
}

.tag-danger {
  background: rgba(244, 67, 54, 0.1);
  color: var(--danger);
}

/* ========== 分隔线 ========== */
.divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 24rpx 0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-state .icon {
  font-size: 120rpx;
  color: var(--text-hint);
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ========== 加载更多 ========== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: var(--text-hint);
  font-size: 24rpx;
}

/* ========== 页面标题 ========== */
.page-header {
  padding: 32rpx 24rpx;
  background: var(--primary);
  color: #FFFFFF;
}

.page-header .title {
  font-size: 36rpx;
  font-weight: 600;
}

.page-header .subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

/* ========== 工具类 ========== */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
